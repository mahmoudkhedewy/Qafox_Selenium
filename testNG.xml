<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression Suite">
    <parameter name="browser" value="chrome" />
    <test name="Regression Test in chrome">
        <classes>
            <class name="tests.AddToCartTest">
                <methods>
                    <include name="addToCart" />
                </methods>
            </class>
            <class name="tests.HoverOverProductsTest">
                <methods>
                    <include name="hoverOverDesktopProducts" />
                </methods>
            </class>
            <class name="tests.LoginTest">
                <methods>
                    <include name="navigateToLoginPage" />
                    <include name="login" />
                </methods>
            </class>
            <class name="tests.RegisterTest">
                <methods>
                    <include name="navigateToRegisterPage" />
                    <include name="enterRegisterData" />
                </methods>
            </class>
        </classes>
    </test>
</suite>